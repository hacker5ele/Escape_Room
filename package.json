{
  "name": "escape-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Der digitale Escape Room",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "npm run build --workspace @escape-room/shared",
    "dev": "concurrently --names shared,backend,frontend --prefix-colors magenta,cyan,green \"npm:dev:shared\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:shared": "npm run dev --workspace @escape-room/shared",
    "dev:backend": "cross-env AUTH_MODE=local npm run dev --workspace @escape-room/backend",
    "dev:frontend": "cross-env VITE_AUTH_MODE=local npm run dev --workspace @escape-room/frontend",
    "build": "npm run build --workspace @escape-room/shared && npm run build --workspace @escape-room/backend && npm run build --workspace @escape-room/frontend",
    "pretypecheck": "npm run build --workspace @escape-room/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build --workspace @escape-room/shared",
    "test": "npm run test --workspaces --if-present",
    "smoke": "node scripts/smoke-test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
