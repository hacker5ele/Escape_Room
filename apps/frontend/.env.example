# Copy to .env for local development.
#
# The publishable key identifies the Clerk instance and carries no authority —
# it ends up in the browser bundle either way, which is what it is for. The
# secret key is a backend concern and must never appear here.
#
# Find it at: Clerk dashboard -> API keys -> Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
