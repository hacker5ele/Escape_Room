# Dependencies
node_modules/
.pnp
.pnp.js

# npm / package manager caches
npm-cache/
.npm/
.npmrc.local
*.tgz
.yarn/
.pnpm-store/

# Build output
dist/
build/
out/
.vite/
*.tsbuildinfo

# Test & lint artifacts
coverage/
.nyc_output/
.eslintcache
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Local data (SQLite files, uploads, volumes)
data/
*.sqlite
*.sqlite3
*.db

# Editors & IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~

# OS noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Terraform — state and plans can contain secrets and must never be committed.
# Real state lives in S3 (see infra/bootstrap.sh).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Variable files may hold account-specific values; the checked-in defaults live
# in variables.tf instead.
*.auto.tfvars
terraform.tfvars

# Tooling state
.omc/
.claude/settings.local.json
.cache/
.temp/
.tmp/

# Character generation — the raw model output, ~118 MB of 1024px PNGs.
# Only the printed WebP parts under apps/frontend/public/characters/ are
# committed; anything here can be recreated with scripts/characters/generate_all.py.
scripts/characters/raw/

# Python bytecode
__pycache__/
*.pyc

# Scenery generation — 54 MB of raw 1024px model output. Only the printed WebP
# under apps/frontend/public/scenery/ is committed; anything here is
# reproducible with scripts/scenery/generate_all.py.
scripts/scenery/raw/
