# Copy to .env and adjust. Never commit the real .env — it is gitignored.

# --- Backend ---
# Port the API listens on.
PORT=3000

# development | production
NODE_ENV=development

# Origin allowed to call the API. In development this is the Vite dev server.
# In production the browser talks to nginx on the same origin, so CORS is not used.
CORS_ORIGIN=http://localhost:5173

# How many answer attempts one client may make per minute, per room.
# Low on purpose: it is what stops a four-digit code being brute-forced.
ATTEMPT_RATE_LIMIT=30

# --- Frontend ---
# Normally leave this unset. The frontend calls the relative path /api, which
# Vite proxies in development and nginx proxies in production. Only set it if
# you deliberately want to point the UI at a backend on another host.
# VITE_API_BASE_URL=
